PORT=3001
FRONTEND_URL=http://127.0.0.1:5173

# E-mail que receberá as solicitações de orçamento.
QUOTE_EMAIL_TO=example
# Configure estes dados com o provedor do e-mail remetente.
# Para Gmail, normalmente é preciso usar uma senha de app.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM="Site Globalfer <seu-email@gmail.com>"
